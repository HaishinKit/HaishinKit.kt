require 'fileutils'
require 'tmpdir'
require 'shellwords'

desc 'Runs the PR review.'
lane :review do
  gradle(task: 'lint')
  native_test_source = File.expand_path('../vulkan/src/test/cpp', __dir__)
  native_test_build = File.expand_path('../build/vulkan-native-tests', __dir__)
  sh('cmake', '-S', native_test_source, '-B', native_test_build)
  sh('cmake', '--build', native_test_build)
  sh('ctest', '--test-dir', native_test_build, '--output-on-failure')
  gradle(task: ':vulkan:assembleDebug')
  gradle(task: ':vulkan:assembleDebugAndroidTest')
  gradle(task: ':haishinkit:testDebugUnitTest')
  gradle(task: ':app:testDebugUnitTest')
  gradle(task: ':rtc:assembleDebug')
  gradle(task: ':rtc:assembleDebugAndroidTest')
  rtc_test_source = File.expand_path('../rtc/src/main/cpp', __dir__)
  rtc_test_build = File.expand_path('../build/rtc-native-tests', __dir__)
  sh('cmake', '-S', rtc_test_source, '-B', rtc_test_build, '-DCMAKE_BUILD_TYPE=Release')
  sh('cmake', '--build', rtc_test_build, '--target', 'haishinkit_rtc', '--parallel', '2')
  gradle(task: ':rtc:testDebugUnitTest', flags: "-PrtcNativeLibraryDir=#{Shellwords.escape(rtc_test_build)}")
  danger(
    danger_id: 'danger',
    dangerfile: 'Dangerfile',
    verbose: true
  ) if Helper.is_ci?
end

desc 'Check API documentation generation without publishing.'
lane :check_documentation do
  gradle(task: 'dokkaGenerate', flags: "--init-script #{Shellwords.escape(File.expand_path('../.github/gradle/dokka.init.gradle', __dir__))}")
end

desc 'Update the API documentation.'
lane :document do |options|
  version = options[:version].to_s
  UI.user_error!('A valid version is required') unless version.match?(/\A[a-zA-Z0-9][a-zA-Z0-9.+-]*\z/)
  source = File.expand_path(options[:source_directory] || '..', __dir__)
  init_script = File.expand_path('../.github/gradle/dokka.init.gradle', __dir__)
  gradle(task: 'dokkaGenerate', project_dir: source, flags: "--init-script #{Shellwords.escape(init_script)}")
  docs = File.join(source, 'docs')
  UI.user_error!('Generated documentation is missing') unless File.file?(File.join(docs, 'index.html'))

  Dir.mktmpdir('haishinkit-documentation-') do |directory|
    repository = File.join(directory, 'site')
    sh('git', 'clone', 'git@github.com:HaishinKit/docs.haishinkit.com.git', repository)
    Dir.chdir(repository) do
      if Helper.is_ci?
        sh('git', 'config', 'user.email', 'action@github.com')
        sh('git', 'config', 'user.name', 'GitHub Action')
      end
      destinations = [version]
      destinations << 'latest' unless options[:update_latest].to_s == 'false'
      destinations.each do |destination|
        target = File.join(repository, 'kt', destination)
        FileUtils.rm_rf(target)
        FileUtils.mkdir_p(File.dirname(target))
        FileUtils.cp_r(docs, target)
      end
      sh('git', 'add', 'kt')
      if system('git', 'diff', '--cached', '--quiet')
        UI.message('Documentation is already up to date')
      else
        sh('git', 'commit', '-m', "Add HaishinKit.kt #{version}")
        sh('git', 'push', 'origin', 'main')
      end
    end
  end
end

# Surface the underlying failure in the Actions summary, including failures before
# Danger can publish its report. Preserve Fastlane's normal failure exit status.
error do |lane, exception|
  if ENV['GITHUB_ACTIONS'] == 'true'
    escape = lambda do |value|
      value.to_s.gsub('%', '%25').gsub("\r", '%0D').gsub("\n", '%0A')
    end
    title = escape.call("Fastlane #{lane} failed").gsub(',', '%2C').gsub(':', '%3A')
    puts "::error title=#{title}::#{escape.call(exception.message)}"
  end
end
