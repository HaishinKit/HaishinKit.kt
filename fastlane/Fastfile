require 'fileutils'
require 'tmpdir'
require 'shellwords'

private_lane :build_native_host do |options|
  component = options.fetch(:component)
  source = component == 'vulkan' ? 'vulkan/src/test/cpp' : 'rtc/src/main/cpp'
  build = File.expand_path("../build/#{component}-native-tests", __dir__)
  configure = ['cmake', '-S', File.expand_path("../#{source}", __dir__), '-B', build]
  configure << '-DCMAKE_BUILD_TYPE=Release' if component == 'rtc'
  sh(*configure)
  compile = ['cmake', '--build', build]
  compile += ['--target', 'haishinkit_rtc', 'rtc_media_test'] if component == 'rtc'
  sh(*compile, '--parallel', '2')
end

desc 'Warm shared native compiler outputs without building sample APKs.'
lane :warm_native_cache do
  %w[vulkan rtc srt].each do |component|
    %w[Debug Release].each do |variant|
      gradle(task: ":#{component}:assemble#{variant}")
    end
  end
  %w[vulkan rtc].each { |component| build_native_host(component: component) }
end

desc 'Runs the PR review.'
lane :review do
  gradle(task: 'lint')
  # Both variants must exercise app-level R8 and packaged library consumer rules.
  gradle(task: ':app:assembleDebug')
  gradle(task: ':app:assembleRelease')
  native_test_build = File.expand_path('../build/vulkan-native-tests', __dir__)
  build_native_host(component: 'vulkan')
  sh('ctest', '--test-dir', native_test_build, '--output-on-failure')
  gradle(task: ':vulkan:assembleDebug')
  gradle(task: ':vulkan:assembleDebugAndroidTest')
  gradle(task: ':haishinkit:testDebugUnitTest')
  gradle(task: ':app:testUiTestUnitTest')
  gradle(task: ':app:testDebugUnitTest')
  gradle(task: ':rtc:assembleDebug')
  gradle(task: ':rtc:assembleDebugAndroidTest')
  rtc_test_build = File.expand_path('../build/rtc-native-tests', __dir__)
  build_native_host(component: 'rtc')
  sh('ctest', '--test-dir', rtc_test_build, '--output-on-failure')
  gradle(task: ':rtc:testDebugUnitTest', flags: "-PrtcNativeLibraryDir=#{Shellwords.escape(rtc_test_build)}")
  danger(
    danger_id: 'danger',
    dangerfile: 'Dangerfile',
    verbose: true
  ) if Helper.is_ci?
end

desc 'Build the signed sample APK for GitHub Releases.'
lane :release_apk do |options|
  version = options[:version].to_s
  code = options[:version_code].to_s
  UI.user_error!('A valid version is required') unless version.match?(/\A[a-zA-Z0-9][a-zA-Z0-9.+-]*\z/)
  UI.user_error!('A positive version code below 2100000000 is required') unless code.match?(/\A[1-9][0-9]*\z/) && code.to_i < 2_100_000_000
  %w[APK_KEYSTORE_PATH APK_KEYSTORE_PASSWORD APK_KEY_ALIAS APK_KEY_PASSWORD].each do |name|
    UI.user_error!("#{name} is required") if ENV[name].to_s.empty?
  end
  UI.user_error!('Signing keystore is missing') unless File.file?(ENV.fetch('APK_KEYSTORE_PATH'))

  gradle(task: ':app:assembleRelease', properties: { 'appVersionName' => version, 'appVersionCode' => code })
  source = File.expand_path('../app/build/outputs/apk/release/app-release.apk', __dir__)
  UI.user_error!('Signed release APK is missing') unless File.file?(source)
  destination = File.expand_path('../build/release', __dir__)
  FileUtils.mkdir_p(destination)
  FileUtils.cp(source, File.join(destination, "HaishinKit-#{version}.apk"))
  mapping = File.expand_path('../app/build/outputs/mapping/release/mapping.txt', __dir__)
  UI.user_error!('Release R8 mapping is missing') unless File.file?(mapping)
  FileUtils.cp(mapping, File.join(destination, "HaishinKit-#{version}-mapping.txt"))
end

desc 'Check API documentation generation without publishing.'
lane :check_documentation do
  gradle(task: 'dokkaGenerate', flags: "--init-script #{Shellwords.escape(File.expand_path('../.github/gradle/dokka.init.gradle', __dir__))}")
end

desc 'Update the API documentation.'
lane :document do |options|
  version = options[:version].to_s
  UI.user_error!('A valid version is required') unless version.match?(/\A[a-zA-Z0-9][a-zA-Z0-9.+-]*\z/)
  source = File.expand_path(options[:source_directory] || '..', __dir__)
  init_script = File.expand_path('../.github/gradle/dokka.init.gradle', __dir__)
  gradle(task: 'dokkaGenerate', project_dir: source, flags: "--init-script #{Shellwords.escape(init_script)}")
  docs = File.join(source, 'docs')
  UI.user_error!('Generated documentation is missing') unless File.file?(File.join(docs, 'index.html'))

  Dir.mktmpdir('haishinkit-documentation-') do |directory|
    repository = File.join(directory, 'site')
    sh('git', 'clone', 'git@github.com:HaishinKit/docs.haishinkit.com.git', repository)
    Dir.chdir(repository) do
      if Helper.is_ci?
        sh('git', 'config', 'user.email', 'action@github.com')
        sh('git', 'config', 'user.name', 'GitHub Action')
      end
      destinations = [version]
      destinations << 'latest' unless options[:update_latest].to_s == 'false'
      destinations.each do |destination|
        target = File.join(repository, 'kt', destination)
        FileUtils.rm_rf(target)
        FileUtils.mkdir_p(File.dirname(target))
        FileUtils.cp_r(docs, target)
      end
      sh('git', 'add', 'kt')
      if system('git', 'diff', '--cached', '--quiet')
        UI.message('Documentation is already up to date')
      else
        sh('git', 'commit', '-m', "Add HaishinKit.kt #{version}")
        sh('git', 'push', 'origin', 'main')
      end
    end
  end
end

# Surface the underlying failure in the Actions summary, including failures before
# Danger can publish its report. Preserve Fastlane's normal failure exit status.
error do |lane, exception|
  if ENV['GITHUB_ACTIONS'] == 'true'
    escape = lambda do |value|
      value.to_s.gsub('%', '%25').gsub("\r", '%0D').gsub("\n", '%0A')
    end
    title = escape.call("Fastlane #{lane} failed").gsub(',', '%2C').gsub(':', '%3A')
    puts "::error title=#{title}::#{escape.call(exception.message)}"
  end
end
